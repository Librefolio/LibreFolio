[run]
source = backend/app
parallel = true
# Misura anche gli archi decisionali, non solo le righe eseguite.
#
# Senza questo, un `if err: log(err)` in cui `err` capita sempre risulta
# interamente coperto pur non avendo mai percorso il ramo «err assente»: la
# riga è verde, la decisione non è mai stata presa in entrambi i sensi. È la
# differenza fra sapere che il codice è stato *toccato* e sapere che è stato
# *esercitato*, e senza la seconda la mappa che guida la scrittura dei test è
# sbagliata proprio dove serve.
#
# La percentuale scende perché il denominatore cresce: non è un peggioramento,
# è il numero vero.
branch = true
# Handle SIGTERM to save coverage data before process exits.
# Without this, SIGTERM kills the process without running atexit handlers,
# so no .coverage.<pid> file is written. Required for E2E test coverage
# where Playwright sends SIGTERM to kill the webServer after tests.
sigterm = true
# Support async/await coverage in FastAPI endpoints
# - thread: for uvicorn running in background thread
# - gevent: for asyncio event loop context switches
concurrency = thread,gevent
omit =
    */test_*
    */tests/*
    */__pycache__/*
    */site-packages/*
    */virtualenvs/*

[report]
show_missing = True
precision = 2
skip_covered = False
exclude_lines =
    # Standard exclusions
    pragma: no cover
    # Abstract methods can never be executed (only subclass overrides run)
    @abstractmethod
    # Debug-only functions (SNB provider)
    def _debug_
    # Defensive/impossible branches
    raise NotImplementedError

[html]
directory = htmlcov
title = LibreFolio Test Coverage Report

