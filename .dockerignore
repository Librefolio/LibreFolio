# =============================================================================
# LibreFolio .dockerignore
# =============================================================================

# Version control
.git/
.gitignore

# Node.js
node_modules/
frontend/node_modules/

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/
htmlcov/
.coverage

# Test data
backend/data/test/

# Development files
LibreFolio_developer_journal/
e2e/
frontend/e2e/
frontend/playwright-report/
frontend/.svelte-kit/

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Documentation sources (we copy the built site, not sources)
mkdocs_src/docs/
mkdocs_src/aphra-pipeline/
mkdocs_src/mkdocs.yml
mkdocs_src/overrides/

# Misc
*.md
!README.md
# Not optional, and not documentation: the BSD/MIT/NCSA/Apache clauses of the
# bundled Python packages require their copyright notices to travel with any
# binary redistribution, and this image is one. The `*.md` sweep above removed
# it from the build context, so `COPY LICENSE THIRD_PARTY_LICENSES.md` in the
# Dockerfile failed the build with "not found" — a file that is present in the
# repository and merely invisible from here. Docker takes the *last* matching
# line, so this exception has to stay below the sweep.
!THIRD_PARTY_LICENSES.md
artwork/
_backup_docs/

