# =============================================================================
# LibreFolio Configuration
# =============================================================================
# This file is loaded by docker-compose.yml via 'env_file: .env'.
#
# PRIORITY ORDER (Docker Compose):
#   1. 'environment:' block in docker-compose.yml  ← wins (forced overrides)
#   2. 'env_file: .env'                            ← this file (user config)
#
# Docker-compose forces HOST=0.0.0.0 and LIBREFOLIO_DATA_DIR to the
# container mount path. Those overrides are necessary for Docker networking
# and volume mapping — do NOT remove them from docker-compose.yml.
# =============================================================================

# =============================================================================
# Production Server
# =============================================================================
HOST=0.0.0.0
PORT=6040
LIBREFOLIO_DATA_DIR=./backend/data/prod
# Data is stored in: <LIBREFOLIO_DATA_DIR>/sqlite/app.db, custom-uploads/, broker_reports/, logs/
# For local development, this path is relative to the project root.
# In Docker, this value is OVERRIDDEN by docker-compose.yml (→ /app/backend/data/prod-docker).
# To change where data lives on the host, edit the bind mount in docker-compose.yml:
#   ./LibreFolio-data:/app/backend/data/prod-docker  ← change left side only

# =============================================================================
# Test Server (used by ./dev.py server --test and automated tests)
# =============================================================================
TEST_PORT=6041
LIBREFOLIO_TEST_DATA_DIR=./backend/data/test
# Test mode is activated via: ./dev.py server --test (sets LIBREFOLIO_TEST_MODE=1)
# LIBREFOLIO_TEST_DATA_DIR is independent from LIBREFOLIO_DATA_DIR.
# Per-run CLI overrides: ./dev.py test --test-port 6141 --data-dir /tmp/librefolio-test-b ...

# =============================================================================
# Login Session Cookie
# =============================================================================
# Secure attribute of the session cookie: auto | always | never (default: auto)
#   auto   → Secure when the browser uses HTTPS, also through a reverse proxy that
#            sends "X-Forwarded-Proto: https" (Tailscale Serve/Funnel, Caddy and
#            Traefik do; Nginx needs: proxy_set_header X-Forwarded-Proto $scheme;)
#   always → always Secure: only when LibreFolio is reached over HTTPS alone
#   never  → never Secure: only when a proxy sends "X-Forwarded-Proto: https"
#            to a browser on plain HTTP, so the login does not stick
# Docs: mkdocs_src → admin/configuration.md
# SESSION_COOKIE_SECURE=auto

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# Image Preview Cache
# =============================================================================
# Max size in MB for in-memory image preview cache (per-process, default: 50)
PREVIEW_CACHE_MAX_MB=50

# =============================================================================
# Asset Search — Web Link-Finder (optional, all have safe defaults)
# =============================================================================
# Last-resort external metasearch used ONLY during interactive asset search
# (never on automated price fetches). Transport = the `ddgs` metasearch library.
# Docs: mkdocs_src → developer/backend/assets/search_link_finder.md
# LIBREFOLIO_WEB_LINK_FINDER_ENABLED=1           # 1/0 master switch
# LIBREFOLIO_WEB_LINK_FINDER_ENGINE=ddgs         # ddgs | apikey  (searxng reserved, Fase B)
# LIBREFOLIO_WEB_LINK_FINDER_DDGS_REGION=wt-wt   # ddgs region (wt-wt worldwide, it-it, us-en, …)
# LIBREFOLIO_WEB_LINK_FINDER_DDGS_BACKEND=auto   # ddgs backend(s): auto | google,bing | …
# LIBREFOLIO_WEB_LINK_FINDER_TIMEOUT=6           # per-request timeout (seconds)
# LIBREFOLIO_WEB_LINK_FINDER_MAX=5               # max candidate URLs returned
# LIBREFOLIO_WEB_LINK_FINDER_API_KEY=            # only for the 'apikey' engine

# =============================================================================
# Docker File Ownership
# =============================================================================
# Build arguments: `docker compose build` reads them, ./dev.py docker build
# auto-detects them. The image's files belong to this UID/GID, and the image
# keeps them as LIBREFOLIO_UID/LIBREFOLIO_GID: the entrypoint hands the data
# directory to those ids and runs the server as them. A change needs a rebuild.
# For manual builds: UID=$(id -u) GID=$(id -g) docker compose build
UID=1000
GID=1000

