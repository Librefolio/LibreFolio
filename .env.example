# =============================================================================
# LibreFolio Configuration
# =============================================================================
# This file is loaded by docker-compose.yml via 'env_file: .env'.
#
# PRIORITY ORDER (Docker Compose):
#   1. 'environment:' block in docker-compose.yml  ← wins (forced overrides)
#   2. 'env_file: .env'                            ← this file (user config)
#
# Docker-compose forces HOST=0.0.0.0, PORT=6040 and LIBREFOLIO_DATA_DIR to
# the container mount path. Those overrides are necessary for Docker networking
# and volume mapping — do NOT remove them from docker-compose.yml. PORT below is
# the host side of the port mapping; inside the container the server listens
# on 6040.
#
# Every option LibreFolio reads is listed here, grouped by what it does.
# A commented line shows the default: uncomment it only to change the value.
# Docs: mkdocs_src → admin/configuration.md
# =============================================================================

# =============================================================================
# Production Server
# =============================================================================
HOST=0.0.0.0
PORT=6040
LIBREFOLIO_DATA_DIR=./backend/data/prod
# Data is stored in: <LIBREFOLIO_DATA_DIR>/sqlite/app.db, custom-uploads/, broker_reports/, logs/, secrets/
# For local development, this path is relative to the project root.
# In Docker, this value is OVERRIDDEN by docker-compose.yml (→ /app/backend/data/prod-docker).
# To change where data lives on the host, edit the bind mount in docker-compose.yml:
#   ./LibreFolio-data:/app/backend/data/prod-docker  ← change left side only

# =============================================================================
# Test Server (used by ./dev.py server --test and automated tests)
# =============================================================================
TEST_PORT=6041
LIBREFOLIO_TEST_DATA_DIR=./backend/data/test
# Test mode is activated via: ./dev.py server --test (sets LIBREFOLIO_TEST_MODE=1)
# LIBREFOLIO_TEST_DATA_DIR is independent from LIBREFOLIO_DATA_DIR.
# Per-run CLI overrides: ./dev.py test --test-port 6141 --data-dir /tmp/librefolio-test-b ...
# A test lane (./dev.py test, ./dev.py server --test) keeps from this file and
# from the shell only the ports, the production data directory, HOST, the log
# level and the LIBREFOLIO_TEST_* names: every other setting below takes its
# default there.

# =============================================================================
# Instance Profile
# =============================================================================
# selfhosted (default): an install you run yourself.
# managed: reserved for hosting providers that run instances for their
# customers; the app reads it from the instance's public configuration.
# LIBREFOLIO_PROFILE=selfhosted

# =============================================================================
# Instance Block (hosting providers)
# =============================================================================
# Leave both unset on your own install. To block the instance (for example
# an unpaid subscription), a hosting provider sets LIBREFOLIO_BLOCKED=true:
# users can still sign in and out, see the block page and delete their own
# account; every other API call answers 423. Accepted values: 1/0,
# true/false, yes/no, on/off; any other stops the server.
# LIBREFOLIO_DELETION_DATE is the day the provider will delete the instance
# and its data (ISO date, e.g. 2026-11-14), shown on the block page.
# LIBREFOLIO_BLOCKED=false
# LIBREFOLIO_DELETION_DATE=

# =============================================================================
# App Version
# =============================================================================
# The version the app reports. Leave it unset: a checkout reports git describe,
# the Docker image its VERSION file. The release workflow sets it to freeze one
# version for every build and server of its job.
# LF_APP_VERSION=

# =============================================================================
# Secrets
# =============================================================================
# Each secret is read from NAME or, when NAME is empty or blank, from the file
# named by NAME_FILE, as Docker secrets mount it (e.g. /run/secrets/jwt_secret).
# A byte order mark at the start of the file and the line breaks at its end are
# dropped. When both are set, NAME wins and a warning is logged. A NAME_FILE
# that is missing, unreadable, empty or blank, not UTF-8 text or larger than
# 64 KiB stops the server at startup for JWT_SECRET and the instance key; for an
# optional secret, such as a plugin's API key, it turns off only the feature
# that needs it, and the log says why.
#
# Key that signs login sessions. Not set: a new key at every start, so every
# user signs in again after a restart. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# JWT_SECRET=
# JWT_SECRET_FILE=
#
# Instance key: the secret LibreFolio derives its encryption keys from. A random
# key of at least 32 characters, never a passphrase, and one per instance:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Not set: generated on first use in <LIBREFOLIO_DATA_DIR>/secrets/instance.key
# (folder 0700, file 0600). Back it up with the data and never change it once
# in use: what was encrypted with the old key could no longer be read.
# LIBREFOLIO_INSTANCE_KEY=
# LIBREFOLIO_INSTANCE_KEY_FILE=

# =============================================================================
# Login Session Cookie
# =============================================================================
# Secure attribute of the session cookie: auto | always | never (default: auto)
#   auto   → Secure when the browser uses HTTPS, also through a reverse proxy that
#            sends "X-Forwarded-Proto: https" (Tailscale Serve/Funnel, Caddy and
#            Traefik do; Nginx needs: proxy_set_header X-Forwarded-Proto $scheme;)
#   always → always Secure: only when LibreFolio is reached over HTTPS alone
#   never  → never Secure: only when a proxy sends "X-Forwarded-Proto: https"
#            to a browser on plain HTTP, so the login does not stick
# Docs: mkdocs_src → admin/configuration.md
# SESSION_COOKIE_SECURE=auto

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# Image Preview Cache
# =============================================================================
# Max size in MB for in-memory image preview cache (per-process, default: 50)
PREVIEW_CACHE_MAX_MB=50

# =============================================================================
# Risk Engines (advanced: the defaults suit most installs)
# =============================================================================
# Simulations and portfolio optimizations run in worker processes, started on
# first use. A value of the wrong type or out of range stops the server.
# RISK_SIMULATION_WORKERS=1                    # worker processes, 1-8
# RISK_OPTIMIZATION_WORKERS=1                  # worker processes, 1-8
# RISK_SIMULATION_QUEUE_CAPACITY=2             # jobs waiting for a worker, 0-64
# RISK_OPTIMIZATION_QUEUE_CAPACITY=2           # jobs waiting for a worker, 0-64
# RISK_SIMULATION_TIMEOUT_SECONDS=120          # time limit of one job
# RISK_OPTIMIZATION_TIMEOUT_SECONDS=60         # time limit of one job
# RISK_SIMULATION_IDLE_TIMEOUT_SECONDS=600     # idle workers stop; 0 = never
# RISK_OPTIMIZATION_IDLE_TIMEOUT_SECONDS=600   # idle workers stop; 0 = never

# =============================================================================
# Asset Search — Web Link-Finder (optional, all have safe defaults)
# =============================================================================
# Last-resort external metasearch used ONLY during interactive asset search
# (never on automated price fetches). Transport = the `ddgs` metasearch library.
# Docs: mkdocs_src → developer/backend/assets/search_link_finder.md
# LIBREFOLIO_WEB_LINK_FINDER_ENABLED=1           # 1/0 master switch
# LIBREFOLIO_WEB_LINK_FINDER_ENGINE=ddgs         # ddgs | apikey  (searxng reserved, Fase B)
# LIBREFOLIO_WEB_LINK_FINDER_DDGS_REGION=wt-wt   # ddgs region (wt-wt worldwide, it-it, us-en, …)
# LIBREFOLIO_WEB_LINK_FINDER_DDGS_BACKEND=auto   # ddgs backend(s): auto | google,bing | …
# LIBREFOLIO_WEB_LINK_FINDER_TIMEOUT=6           # per-request timeout (seconds)
# LIBREFOLIO_WEB_LINK_FINDER_MAX=5               # max candidate URLs returned
# LIBREFOLIO_WEB_LINK_FINDER_API_KEY=            # only for the 'apikey' engine
# LIBREFOLIO_WEB_LINK_FINDER_API_KEY_FILE=       # or a file holding it (see Secrets)

# =============================================================================
# Accounts
# =============================================================================
# No options yet.

# =============================================================================
# Plugins
# =============================================================================
# No options yet.

# =============================================================================
# Sleep and Wake
# =============================================================================
# No options yet.

# =============================================================================
# Backup and Litestream
# =============================================================================
# No options yet.

# =============================================================================
# Email
# =============================================================================
# No options yet.

# =============================================================================
# Set by the Tools (do not set them here)
# =============================================================================
# ./dev.py and the test runners set these; they are listed so that every
# option LibreFolio reads appears in this file.
# LIBREFOLIO_TEST_MODE=0       # 1, true or yes: use the test data folder
# LIBREFOLIO_LOG_LEVEL=        # replaces LOG_LEVEL (./dev.py server --debug)
# LIBREFOLIO_NO_SCHEDULER=     # any value turns the scheduled syncs off

# =============================================================================
# Docker File Ownership
# =============================================================================
# Build arguments: `docker compose build` reads them, ./dev.py docker build
# auto-detects them. The image's files belong to this UID/GID, and the image
# keeps them as LIBREFOLIO_UID/LIBREFOLIO_GID: the entrypoint hands the data
# directory to those ids and runs the server as them. A change needs a rebuild.
# For manual builds: UID=$(id -u) GID=$(id -g) docker compose build
UID=1000
GID=1000

# =============================================================================
# Docker Image (read by docker compose)
# =============================================================================
# Image to run, when not the default of the compose file in use:
# librefolio:latest for docker-compose.yml (built locally), and
# ghcr.io/librefolio/librefolio:latest for docker-compose.prod.yml.
# To pin a release: ghcr.io/librefolio/librefolio:1.2.3
# LIBREFOLIO_IMAGE=
# Variant built by `docker compose build`: full, or light (no docs images).
# DOCS_VARIANT=full
