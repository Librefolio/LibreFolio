# =============================================================================
# LibreFolio Configuration
# =============================================================================
# This file is loaded by docker-compose.yml via 'env_file: .env'.
#
# PRIORITY ORDER (Docker Compose):
#   1. 'environment:' block in docker-compose.yml  ← wins (forced overrides)
#   2. 'env_file: .env'                            ← this file (user config)
#
# Docker-compose forces HOST=0.0.0.0, PORT=6040 and LIBREFOLIO_DATA_DIR to
# the container mount path. Those overrides are necessary for Docker networking
# and volume mapping — do NOT remove them from docker-compose.yml. PORT below is
# the host side of the port mapping; inside the container the server listens
# on 6040.
#
# Every option LibreFolio reads is listed here, grouped by what it does.
# A commented line shows the default: uncomment it only to change the value.
# Docs: mkdocs_src → admin/configuration.md
# =============================================================================

# =============================================================================
# Production Server
# =============================================================================
HOST=0.0.0.0
PORT=6040
LIBREFOLIO_DATA_DIR=./backend/data/prod
# Data is stored in: <LIBREFOLIO_DATA_DIR>/sqlite/app.db, custom-uploads/, broker_reports/, logs/, secrets/
# For local development, this path is relative to the project root.
# In Docker, this value is OVERRIDDEN by docker-compose.yml (→ /app/backend/data/prod-docker).
# To change where data lives on the host, edit the bind mount in docker-compose.yml:
#   ./LibreFolio-data:/app/backend/data/prod-docker  ← change left side only

# =============================================================================
# Test Server (used by ./dev.py server --test and automated tests)
# =============================================================================
TEST_PORT=6041
LIBREFOLIO_TEST_DATA_DIR=./backend/data/test
# Test mode is activated via: ./dev.py server --test (sets LIBREFOLIO_TEST_MODE=1)
# LIBREFOLIO_TEST_DATA_DIR is independent from LIBREFOLIO_DATA_DIR.
# Per-run CLI overrides: ./dev.py test --test-port 6141 --data-dir /tmp/librefolio-test-b ...
# A test lane (./dev.py test, ./dev.py server --test) keeps from this file and
# from the shell only the ports, the production data directory, HOST, the log
# level and the LIBREFOLIO_TEST_* names: every other setting below takes its
# default there.

# =============================================================================
# Instance Profile
# =============================================================================
# selfhosted (default): an install you run yourself.
# managed: reserved for hosting providers that run instances for their
# customers; the app reads it from the instance's public configuration.
# managed also changes these defaults, unless you set them: idle risk workers
# stop after 60 s, frame protection and the report-only CSP are on.
# LIBREFOLIO_PROFILE=selfhosted
# X-Frame-Options: SAMEORIGIN and CSP frame-ancestors 'self' on every response.
# Off by default: dashboards (Home Assistant panels) may embed a self-hosted app.
# LIBREFOLIO_FRAME_PROTECTION=false            # managed: true
# Report-only Content-Security-Policy on the web app's pages: violations show
# in the browser console, nothing is blocked.
# LIBREFOLIO_CSP_REPORT_ONLY=false             # managed: true
# Where your users ask for help, such as an asset the search does not find:
# a page (http:// or https://) or one email address (mailto:help@example.org).
# The address is public: every user sees it. Unset: the project's issues on GitHub.
# LIBREFOLIO_SUPPORT_URL=
# The terms of service and the privacy policy of the instance (http:// or https://),
# linked by the legal notice every user sees (About, the sign-in pages, the welcome,
# the sidebar). Unset: no link, the notice alone. An invalid address is logged and hidden.
# LIBREFOLIO_TOS_URL=
# LIBREFOLIO_PRIVACY_URL=

# =============================================================================
# Instance Block (hosting providers)
# =============================================================================
# Leave both unset on your own install. To block the instance (for example
# an unpaid subscription), a hosting provider sets LIBREFOLIO_BLOCKED=true:
# users can still sign in and out, see the block page and delete their own
# account; every other API call answers 423. Accepted values: 1/0,
# true/false, yes/no, on/off; any other stops the server.
# LIBREFOLIO_DELETION_DATE is the day the provider will delete the instance
# and its data (ISO date, e.g. 2026-11-14), shown on the block page.
# LIBREFOLIO_BLOCKED=false
# LIBREFOLIO_DELETION_DATE=

# =============================================================================
# App Version
# =============================================================================
# The version the app reports. Leave it unset: a checkout reports git describe,
# the Docker image its VERSION file. The release workflow sets it to freeze one
# version for every build and server of its job.
# LF_APP_VERSION=

# =============================================================================
# Secrets
# =============================================================================
# Each secret is read from NAME or, when NAME is empty or blank, from the file
# named by NAME_FILE, as Docker secrets mount it (e.g. /run/secrets/jwt_secret).
# A byte order mark at the start of the file and the line breaks at its end are
# dropped. When both are set, NAME wins and a warning is logged. A NAME_FILE
# that is missing, unreadable, empty or blank, not UTF-8 text or larger than
# 64 KiB stops the server at startup for JWT_SECRET and the instance key; for an
# optional secret, such as a plugin's API key, it turns off only the feature
# that needs it, and the log says why.
#
# Key that signs login sessions. Not set: a new key at every start, so every
# user signs in again after a restart. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# JWT_SECRET=
# JWT_SECRET_FILE=
#
# Instance key: the secret LibreFolio derives its encryption keys from. A random
# key of at least 32 characters, never a passphrase, and one per instance:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Not set: generated on first use in <LIBREFOLIO_DATA_DIR>/secrets/instance.key
# (folder 0700, file 0600). Back it up with the data and never change it once
# in use: what was encrypted with the old key could no longer be read.
# LIBREFOLIO_INSTANCE_KEY=
# LIBREFOLIO_INSTANCE_KEY_FILE=

# =============================================================================
# Login Session Cookie
# =============================================================================
# Secure attribute of the session cookie: auto | always | never (default: auto)
#   auto   → Secure when the browser uses HTTPS, also through a reverse proxy that
#            sends "X-Forwarded-Proto: https" (Tailscale Serve/Funnel, Caddy and
#            Traefik do; Nginx needs: proxy_set_header X-Forwarded-Proto $scheme;)
#   always → always Secure: only when LibreFolio is reached over HTTPS alone
#   never  → never Secure: only when a proxy sends "X-Forwarded-Proto: https"
#            to a browser on plain HTTP, so the login does not stick
# Docs: mkdocs_src → admin/configuration.md
# SESSION_COOKIE_SECURE=auto

# =============================================================================
# The Visitor's Address Behind a Reverse Proxy
# =============================================================================
# The header in which your reverse proxy passes the visitor's address, read by
# the per-client limits (sign-up and password-reset emails). Leave it unset
# unless every request crosses that proxy, and the proxy sets the header
# itself: a client reaching LibreFolio directly could send it and choose any
# address. One address per header only: Fly-Client-IP on Fly.io, X-Real-IP
# from Nginx (proxy_set_header X-Real-IP $remote_addr;). X-Forwarded-For is
# refused: for it, set FORWARDED_ALLOW_IPS, which uvicorn reads. Unset: the
# connection's address. No profile sets it.
# Behind a reverse proxy that neither this header nor FORWARDED_ALLOW_IPS
# covers, every visitor has the proxy's address: LibreFolio notices it (a
# forwarding header from a local address) and warns, once in the log and in
# the security checks.
# Docs: mkdocs_src → admin/connection_checks.md
# LIBREFOLIO_CLIENT_IP_HEADER=

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# Image Preview Cache
# =============================================================================
# Max size in MB for in-memory image preview cache (per-process, default: 50)
PREVIEW_CACHE_MAX_MB=50

# =============================================================================
# Risk Engines (advanced: the defaults suit most installs)
# =============================================================================
# Simulations and portfolio optimizations run in worker processes, started on
# first use. A value of the wrong type or out of range stops the server.
# RISK_SIMULATION_WORKERS=1                    # worker processes, 1-8
# RISK_OPTIMIZATION_WORKERS=1                  # worker processes, 1-8
# RISK_SIMULATION_QUEUE_CAPACITY=2             # jobs waiting for a worker, 0-64
# RISK_OPTIMIZATION_QUEUE_CAPACITY=2           # jobs waiting for a worker, 0-64
# RISK_SIMULATION_TIMEOUT_SECONDS=120          # time limit of one job
# RISK_OPTIMIZATION_TIMEOUT_SECONDS=60         # time limit of one job
# RISK_SIMULATION_IDLE_TIMEOUT_SECONDS=600     # idle workers stop; 0 = never; managed: 60
# RISK_OPTIMIZATION_IDLE_TIMEOUT_SECONDS=600   # idle workers stop; 0 = never; managed: 60

# =============================================================================
# Broker Import (advanced: the default suits most installs)
# =============================================================================
# Make the import workers ready at startup, with the import plugins loaded: the
# first import of a broker file after a start is then ~4 s faster, for ~80 MB of
# memory held from the start and ~1.4 s of CPU at every server start. Off by
# default; on in test mode. 1/true/yes/on or 0/false/no/off; any other value
# is logged at startup and leaves it off.
# LIBREFOLIO_BRIM_PREWARM=false   # test mode: true

# =============================================================================
# Asset Search — Web Link-Finder (optional, all have safe defaults)
# =============================================================================
# Last-resort external metasearch used ONLY during interactive asset search
# (never on automated price fetches). Transport = the `ddgs` metasearch library.
# Docs: mkdocs_src → developer/backend/assets/search_link_finder.md
# LIBREFOLIO_WEB_LINK_FINDER_ENABLED=1           # 1/0 master switch
# LIBREFOLIO_WEB_LINK_FINDER_ENGINE=ddgs         # ddgs | apikey  (searxng reserved, Fase B)
# LIBREFOLIO_WEB_LINK_FINDER_DDGS_REGION=wt-wt   # ddgs region (wt-wt worldwide, it-it, us-en, …)
# LIBREFOLIO_WEB_LINK_FINDER_DDGS_BACKEND=auto   # ddgs backend(s): auto | google,bing | …
# LIBREFOLIO_WEB_LINK_FINDER_TIMEOUT=6           # per-request timeout (seconds, at least 1)
# LIBREFOLIO_WEB_LINK_FINDER_MAX=5               # max candidate URLs returned (at least 1)
# LIBREFOLIO_WEB_LINK_FINDER_API_KEY=            # only for the 'apikey' engine
# LIBREFOLIO_WEB_LINK_FINDER_API_KEY_FILE=       # or a file holding it (see Secrets)

# =============================================================================
# Accounts
# =============================================================================
# Who may create an account: open | invite | disabled. Unset: the "Registration" global setting decides (by
# invitation on a new install, as before on an upgraded one), and an administrator can change it; set: it pins the
# mode and the setting is read-only. Any other value keeps registration closed and is logged. The first account of
# an instance without accounts registers in any mode and is an administrator, unless LIBREFOLIO_ADMIN_EMAIL is set.
# LIBREFOLIO_REGISTRATION=
# How many accounts the instance may hold (active users, pending invitations and an initial administrator waiting
# for its setup link). Unset: no limit.
# LIBREFOLIO_MAX_USERS=
# The address users reach the instance at (http:// or https://), for links built outside a browser: the
# command line, emails. Unset: the command line prints the path only.
# LIBREFOLIO_PUBLIC_URL=
# Where the administrator of a managed instance manages the subscription; shown to administrators only.
# LIBREFOLIO_BILLING_URL=
# The limit on failed sign-ins: after 10 in 15 minutes for one user name or email, or 50 from one address, the
# sign-in answers "too many attempts" until the oldest is 15 minutes old. On by default; off only for a test
# instance (the server then warns in its log at every start). Any other value stops the server.
# LIBREFOLIO_LOGIN_LIMIT=on
#
# The initial administrator, for hosting providers and scripted installs. With LIBREFOLIO_ADMIN_EMAIL set, the
# first start of an instance without accounts creates that administrator, not yet active, sets registration to
# invitations and issues a single-use setup link valid 72 hours: the administrator opens it, chooses the password
# and is signed in. Without a token below the server generates one: the link is written once in the log, and
# emailed to that address when email works (see Email). Meanwhile nobody can register as the first account. On an
# instance that already has accounts these variables are ignored. A value that cannot be used stops the server,
# naming the variable.
# LIBREFOLIO_ADMIN_EMAIL=
# The administrator's username: 3 to 50 characters, without @ (the sign-in reads a name with @ as an address).
# LIBREFOLIO_ADMIN_USERNAME=admin
# The setup link's token, when a hosting panel delivers the link itself: 32 to 200 letters, digits or - . _ ~,
# for example the output of `openssl rand -hex 32`. Also as LIBREFOLIO_ADMIN_BOOTSTRAP_TOKEN_FILE (see Secrets).
# A new value, set while the administrator still waits, re-arms the link for 72 hours; without one,
# ./dev.py user setup-link prints a new link.
# LIBREFOLIO_ADMIN_BOOTSTRAP_TOKEN=

# =============================================================================
# Plugins
# =============================================================================
# A plugin may declare settings, which an administrator (instance-wide fields)
# or each user (personal fields) sets in the app. An instance-wide field can
# also be set here: the variable then wins over the app and locks the field;
# an invalid value stops that plugin until it is fixed, and the log says why.
# Its name is derived from the field,
#   LIBREFOLIO_PLUGIN_<FAMILY>_<PLUGIN CODE>_<FIELD KEY>, uppercase,
#   for example LIBREFOLIO_PLUGIN_ASSET_MYPROVIDER_API_KEY,
# or, for a secret, the older name the field declares as its alias. Every one
# accepts the _FILE form too (see Secrets). The plugins shipped today declare
# no instance-wide field.
#
# The order of the price providers in the asset search. A provider declares
# its tier (premium, such as licensed data, or community, the default) and its
# priority; premium results come first when at least one premium provider is
# available. Comma-separated provider codes; unset: what the providers
# declare, so the search keeps its order. A code no provider has is ignored
# and logged.
# LIBREFOLIO_ASSET_PROVIDERS_PREMIUM=          # exactly these are premium
# LIBREFOLIO_ASSET_PROVIDERS_ORDER=            # these first, in this order

# =============================================================================
# Sleep and Wake
# =============================================================================
# Pause a price provider after it answers "too many requests" (HTTP 429): no
# call reaches it until the pause ends, from the scheduler or from a live
# price request, and the last stored price stays on screen meanwhile. The
# first pause lasts BASE seconds and doubles at each refusal in a row, up to
# MAX; a Retry-After sent by the provider is honoured, up to one day.
# On by default: an exception to the rule that a new variable leaves an
# install as it was, by developer decision 34 (15/10/2026). BASE=0 turns the
# pauses off, as before release 1.3. A value that cannot be used is logged
# and the defaults apply.
# LIBREFOLIO_PROVIDER_COOLDOWN_BASE_SECONDS=60   # first pause; 0 = off, max 86400
# LIBREFOLIO_PROVIDER_COOLDOWN_MAX_SECONDS=3600  # longest pause, 1-86400
#
# How long the server may take to stop after a SIGTERM or a SIGINT (docker
# stop, a restart, Ctrl+C): 3/8 to finish the requests in flight, the rest to
# stop its work; past it the process ends anyway. For every install, by
# developer decision 35 (15/10/2026); 0 removes the limit, as before release
# 1.3. Give the container more time than this to stop (Docker waits 10 s by
# default). The Docker entrypoint and ./dev.py server hand uvicorn its share
# as UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN, unless you set that one yourself.
# LIBREFOLIO_SHUTDOWN_TIMEOUT_SECONDS=8          # 0 = no limit, otherwise 2-600
#
# Optional. The token of the scheduled wake-up, POST /api/v1/system/wake-sync:
# a hosting panel, or a cron of yours, calls it to run the price and exchange
# rate updates that are due, without a user. Sent only as an "Authorization:
# Bearer" header; at least 32 visible ASCII characters, no spaces, e.g. the
# output of `openssl rand -hex 32`. Use a token of its own, not the backup one.
# Not set: the route answers 404, as if absent.
# LIBREFOLIO_WAKE_TOKEN=
# LIBREFOLIO_WAKE_TOKEN_FILE=
#
# Optional, for Fly.io. With MODE=fly the machine asks Fly to suspend it after
# MINUTES without a request of a user (the health checks and the scheduled
# wake-up do not count) and with no work in progress (a scheduled job, a
# backup, a tool). Fly's proxy resumes it at the next request; set
# auto_stop_machines = "off" in fly.toml, so that Fly does not stop it on its
# own. none, the default, never suspends: on any other host leave it unset.
# LIBREFOLIO_IDLE_SUSPEND_MODE=none               # none | fly
# LIBREFOLIO_IDLE_SUSPEND_MINUTES=5               # 1-1440, used with fly

# =============================================================================
# Backup and Litestream
# =============================================================================
# Optional, for hosting providers. The token of a hosting panel that downloads
# backups of this instance (/api/v1/backup/panel/jobs), sent as
# "Authorization: Bearer <token>". At least 32 visible ASCII characters, no
# spaces, e.g. the output of `openssl rand -hex 32`. Not set: those routes
# answer 404, as if absent.
# LIBREFOLIO_BACKUP_DOWNLOAD_TOKEN=
# LIBREFOLIO_BACKUP_DOWNLOAD_TOKEN_FILE=
#
# The largest backup archive a restore accepts, in megabytes; 0 is no limit.
# The hosting provider sets it: in the cloud the customer is the administrator.
# Not set: no limit on a self-hosted instance, 500 in the managed profile
# (LIBREFOLIO_PROFILE=managed).
# LIBREFOLIO_BACKUP_MAX_UPLOAD_MB=0

# =============================================================================
# Email
# =============================================================================
# Optional. Without LIBREFOLIO_SMTP_HOST nothing is sent, and everything works
# as without email. The SMTP configuration is read only from here or from
# secret files: never stored in the database, shown in the interface or put in
# a backup. A value that cannot be used turns email off and is logged; the
# server starts anyway.
# Docs: mkdocs_src → admin/email.md
#
# SMTP server: a host name or an IP address, without scheme or port. Not set: email off.
# LIBREFOLIO_SMTP_HOST=
# Encryption: starttls (upgrades the connection, never sends in clear),
# tls (TLS from the first byte, usually port 465) or none (local relay only).
# LIBREFOLIO_SMTP_TLS=starttls
# Port. Not set: 587 with starttls, 465 with tls, 25 with none.
# LIBREFOLIO_SMTP_PORT=
# Login of the SMTP server, with its password; neither for a relay without login.
# LIBREFOLIO_SMTP_USER=
# LIBREFOLIO_SMTP_PASSWORD=
# LIBREFOLIO_SMTP_PASSWORD_FILE=
# Sender, required with a host, e.g. LibreFolio <noreply@example.com>
# LIBREFOLIO_SMTP_FROM=
# Where replies go, when not to the sender.
# LIBREFOLIO_SMTP_REPLY_TO=
# How many emails the instance may send in an hour, per server process.
# LIBREFOLIO_SMTP_MAX_PER_HOUR=50
# Emails with a link (forgotten password, invitations and reset links sent by
# email) build it only from LIBREFOLIO_PUBLIC_URL (Accounts section): without
# it, no email with a link goes out.

# =============================================================================
# Set by the Tools (do not set them here)
# =============================================================================
# ./dev.py and the test runners set these; they are listed so that every
# option LibreFolio reads appears in this file.
# LIBREFOLIO_TEST_MODE=0       # 1, true or yes: use the test data folder
# LIBREFOLIO_LOG_LEVEL=        # replaces LOG_LEVEL (./dev.py server --debug)
# LIBREFOLIO_NO_SCHEDULER=     # any value turns the scheduled syncs off

# =============================================================================
# Docker File Ownership
# =============================================================================
# Build arguments: `docker compose build` reads them, ./dev.py docker build
# auto-detects them. The image's files belong to this UID/GID, and the image
# keeps them as LIBREFOLIO_UID/LIBREFOLIO_GID: the entrypoint hands the data
# directory to those ids and runs the server as them. A change needs a rebuild.
# For manual builds: UID=$(id -u) GID=$(id -g) docker compose build
UID=1000
GID=1000

# =============================================================================
# Docker Image (read by docker compose)
# =============================================================================
# Image to run, when not the default of the compose file in use:
# librefolio:latest for docker-compose.yml (built locally), and
# ghcr.io/librefolio/librefolio:latest for docker-compose.prod.yml.
# To pin a release: ghcr.io/librefolio/librefolio:1.2.3
# LIBREFOLIO_IMAGE=
# Variant built by `docker compose build`: full, or light (no docs images).
# DOCS_VARIANT=full
