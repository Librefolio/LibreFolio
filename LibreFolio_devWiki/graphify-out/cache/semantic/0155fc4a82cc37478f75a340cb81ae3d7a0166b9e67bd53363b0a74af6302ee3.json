{"nodes": [{"id": "mkdocs_ai_export_component_runtime_page", "label": "AI Export Component Runtime", "file_type": "document", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_snapshot.md", "source_location": "L1-L5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "mkdocs_ai_export_semantic_composition_v2_hard_cutover", "label": "Semantic Composition V2 Hard Cutover", "file_type": "rationale", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_snapshot.md", "source_location": "L7-L11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frontend and backend use the V2 schema, catalog, and selection contract together, reject V1 identities, and provide no compatibility fallback or parallel legacy runtime."}, {"id": "mkdocs_ai_export_component_dataset_analysis_runtime", "label": "Component-Dataset-Analysis Runtime", "file_type": "rationale", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_snapshot.md", "source_location": "L13-L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Granular components compose datasets, and analyses compose datasets with frontend-owned instructions and response contracts inside one extended V2 registry model."}, {"id": "mkdocs_ai_export_authenticated_snapshot_runtime_flow", "label": "Authenticated Snapshot Runtime Flow", "file_type": "rationale", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_snapshot.md", "source_location": "L44-L72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The frontend loads the V2 catalog, posts an authenticated selection and accessible broker scope, receives ordered factual component envelopes, validates the response, renders trusted local prompt text, and writes it to the clipboard."}, {"id": "mkdocs_ai_export_backend_frontend_ownership_boundary", "label": "AI Export Backend-Frontend Ownership Boundary", "file_type": "rationale", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_snapshot.md", "source_location": "L74-L89", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The backend owns factual meaning, registries, applicability, sampling, and failures; the frontend owns localized presentation, trusted prompt instructions, response contracts, safe serialization, and clipboard transport without recalculating facts."}, {"id": "mkdocs_ai_export_deterministic_density_not_truncation", "label": "Deterministic Density Reduction, Not Truncation", "file_type": "rationale", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_snapshot.md", "source_location": "L124-L143", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI Export preserves scope and detail without token truncation, pagination, automatic downgrade, or entity removal; technical history uses deterministic density reduction and events use deterministic per-annotation selection."}, {"id": "mkdocs_ai_export_focused_analysis_dataset_strategy", "label": "Focused Analysis Dataset Strategy", "file_type": "rationale", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_snapshot.md", "source_location": "L145-L160", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-technical analyses receive backend-owned focused datasets and deterministic task evidence by default, while complete technical datasets remain intact and available as explicit or recommended data."}], "edges": [{"source": "mkdocs_ai_export_component_runtime_page", "target": "mkdocs_ai_export_semantic_composition_v2_hard_cutover", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_snapshot.md", "source_location": "L7-L1