{"nodes": [{"id": "risk_g6_application_contracts_decision", "label": "Risk G6 Application Contracts", "file_type": "rationale", "source_file": "wiki/decisions/risk-g6-application-contracts.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "G6 implementation requires explicit contracts for historical replay auditability, lazy-panel retention, hypothetical-shock bucket visibility, and scenario-tag semantics before dependent work can proceed."}, {"id": "risk_g6_application_contracts_historical_replay_audit", "label": "Historical Replay Audit Trail", "file_type": "rationale", "source_file": "wiki/decisions/risk-g6-application-contracts.md", "source_location": "Historical replay audit", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Historical replay must expose a typed serializable trail containing proxy and exclusion counts, original-to-proxy mappings, excluded assets and policies, missing-history policy, and effective composition policy."}, {"id": "risk_g6_application_contracts_proxy_exclusion_cache_identity", "label": "Proxy and Exclusion Cache Identity", "file_type": "rationale", "source_file": "wiki/decisions/risk-g6-application-contracts.md", "source_location": "Historical replay audit", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proxy mappings and exclusions participate in canonical request and cache identity so materially different replay executions cannot share cached results."}, {"id": "risk_g6_application_contracts_risk_result_metadata", "label": "RiskResultMetadata", "file_type": "document", "source_file": "wiki/decisions/risk-g6-application-contracts.md", "source_location": "Historical replay audit", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "risk_g6_application_contracts_data_quality_report", "label": "DataQualityReport", "file_type": "document", "source_file": "wiki/decisions/risk-g6-application-contracts.md", "source_location": "Historical replay audit", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "risk_g6_application_contracts_lazy_panel_retention", "label": "Lazy Panel State Retention", "file_type": "rationale", "source_file": "wiki/decisions/risk-g6-application-contracts.md", "source_location": "Lazy panels and cache", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Closing an accordion panel is not data invalidation; reopening the same canonical request reuses its in-flight, result, or error state without refetching."}, {"id": "risk_g6_application_contracts_canonical_request_identity", "label": "Canonical Risk Request Identity", "file_type": "rationale", "source_file": "wiki/decisions/risk-g6-application-contracts.md", "source_location": "Lazy panels and cache", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Date, scope, currency, analytic parameters, scenario configuration, proxy mapping, and every relevant input determine risk request identity, while sync or mutations may invalidate unchanged identities."}, {"id": "risk_g6_application_contracts_risk_store_session_cache", "label": "riskStore Session Cache Optimization", "file_type": "rationale", "source_file": "wiki/decisions/risk-g6-application-contracts.md", "source_location": "Lazy panels and cache", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same-mount retention is guaranteed by the UI, while cross-mount riskStore reuse is only a session-cache optimization."}, {"id": "risk_g6_application_contracts_hypothetical_shock_bucket_visibility", "label": "Hypothetical-Shock Bucket Visibility", "file_type": "rationale", "source_file": "wiki/decisions/risk-g6-application-contracts.md", "source_location": "Hypothetical-shock buckets", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Editors show buckets present in scope by default, retain Other and valid manually edited buckets, and offer Show all without changing effective configuration or calculations."}, {"id": "risk_g6_application_contracts_applied_bucket_audit", "label": "Applied Shock Bucket Audit", "file_type": "rationale", "source_file": "wiki/decisions/risk-g6-application-contracts.md", "source_location": "Hypothetical-shock buckets", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requests and metadata preserve every configured shock, while results report the buckets and precedence actually applied."}, {"id": "risk_g6_application_contracts_scenario_yaml_tags", "label": "Scenario YAML Discovery Tags", "file_type": "rationale", "source_file": "wiki/decisions/risk-g6-application-contracts.md", "source_location": "YAML tags", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scenario tags are lowercase unique bounded slugs with an open vocabulary; they are inert discovery metadata, not localized copy, financial semantics, or calculation-cache identity."}, {"id": "risk_g6_application_contracts_risk_quant_engine_process_boundary", "label": "Risk Quant Engine Process Boundary", "file_type": "document", "source_file": "wiki/decisions/risk-g6-application-contracts.md", "source_location": "Related frontmatter", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "risk_g6_application_contracts_cancellation_safe_inflight_deduplication", "label": "Cancellation-Safe In-Flight Deduplication", "file_type": "document", "source_file": "wiki/decisions/risk-g6-application-contracts.md", "source_location": "Related frontmatter", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "risk_g6_application_contracts_backend_only_calculations", "label": "Backend-Only Calculations", "file_type": "document", "source_fi