{"nodes": [{"id": "mkdocs_ai_export_composition_and_prompt_page", "label": "AI Export Composition and Prompt", "file_type": "document", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_composition.md", "source_location": "L1-L4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "mkdocs_ai_export_component_spec_runtime_unit", "label": "ComponentSpec Runtime Unit", "file_type": "rationale", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_composition.md", "source_location": "L6-L33", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ComponentSpec is the smallest declarative buildable fact, with stable component and schema identities, a strict output model, a builder, dependencies, and temporal metadata."}, {"id": "mkdocs_ai_export_build_context_resource_memoization", "label": "BuildContext Resource Memoization", "file_type": "rationale", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_composition.md", "source_location": "L35-L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One request-scoped BuildContext memoizes component outcomes and typed source resources, coordinates shared AsyncSession access, and records sampling and event-selection usage."}, {"id": "mkdocs_ai_export_dataset_spec_composition", "label": "DatasetSpec Composition", "file_type": "rationale", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_composition.md", "source_location": "L50-L87", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DatasetSpec declares required and optional components plus exact order and period/detail semantics; all_data is a computed canonical union that excludes duplicate focused projections."}, {"id": "mkdocs_ai_export_focused_technical_projection_strategy", "label": "Focused Technical Projection Strategy", "file_type": "rationale", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_composition.md", "source_location": "L89-L110", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backend-owned focused projections reuse request-scoped price, rate, and Signal resources while declaring deterministic allowlists, history depth, and event policies instead of filtering rendered complete payloads."}, {"id": "mkdocs_ai_export_market_events_review_evidence_binding", "label": "Market Events Review Evidence Binding", "file_type": "rationale", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_composition.md", "source_location": "L205-L220", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The portfolio.market_events_review analysis requires overview and asset-comparison evidence, may add performance flows, and recommends complete technical data as Additional Data rather than loading it by default."}, {"id": "mkdocs_ai_export_analysis_spec_prompt_contract", "label": "AnalysisSpec Prompt Contract", "file_type": "rationale", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_composition.md", "source_location": "L258-L270", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AnalysisSpec binds required and optional datasets, applicability, versioned frontend instruction and response-contract identities, note support, and structured Additional Data recommendations."}, {"id": "mkdocs_ai_export_deterministic_composer_ordering", "label": "Deterministic Composer Ordering and Deduplication", "file_type": "rationale", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_composition.md", "source_location": "L272-L285", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Composition follows declared required, optional, and section order, deduplicates shared envelopes by component identity and version, and never changes order because of token budgets or heuristic relevance."}, {"id": "mkdocs_ai_export_technical_sampling_manifest_contract", "label": "Technical Sampling Manifest Contract", "file_type": "rationale", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_composition.md", "source_location": "L330-L360", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Public metadata exposes detail level, price bucket count, and per-indicator temporal class and bucket count, while internal P, M, and K diagnostics stay out of the copied prompt."}, {"id": "mkdocs_ai_export_real_prompt_density_probe", "label": "Real Prompt Density Probe", "file_type": "rationale", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_composition.md", "source_location": "L363-L424", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The permanent probe exercises the official login-to-renderer path and measures final saved prompt content across periods and detail levels using an immutable copied source database."}], "edges": [{"source": "mkdocs_ai_export_composition_and_prompt_page", "target": "mkdocs_ai_export_component_spec_runtime_unit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_composition.md", "source_location": "L6-L33", "weight": 1.0}, {"source": "mkdocs_ai_export_composition_and_prompt_page", "target": "mkdocs_ai_export_build_context_resource_memoization", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_composition.md", "source_location": "L35-L48", "weight": 1.0}, {"source": "mkdocs_ai_export_composition_and_prompt_page", "target": "mkdocs_ai_export_dataset_spec_composition", "relation": "references", "conf