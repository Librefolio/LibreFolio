{"nodes": [{"id": "wiki_decisions_ai-export-versioned-snapshot-boundary", "label": "Backend-owned versioned AI snapshots with frontend-owned prompt/clipboard boundary", "description": "Decision establishing the backend/frontend ownership split for AI Export V2: exact fail-closed catalog, backend factual ownership, frontend presentation ownership, and hard cutover; updated 2026-08-04 to reference the catalog granularity/composition concept.", "file_type": "document", "source_file": "wiki/decisions/ai-export-versioned-snapshot-boundary.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"label": "Explicit Broker Universe Nomenclature: accessible_broker_count / scoped_broker_count / position_broker_count / period_contributor_broker_count", "description": "Four distinct Broker universe counts: accessible_broker_count is the authorization universe; scoped_broker_count/broker_scope is the effective calculation universe; position_broker_count counts Brokers with open positions at snapshot date; period_contributor_broker_count counts period-performance contributors. The Entity Directory follows effective scoped Brokers including a scoped Broker with no current position row. Approved on 3 August 2026; validated by targeted run 20260801T085820.657238Z.", "file_type": "rationale", "source_file": "wiki/decisions/ai-export-versioned-snapshot-boundary.md", "source_location": "## Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "concept_broker_universe_nomenclature_accessible_scoped_position_period"}, {"label": "Deferred IT/FR/ES User Guide Translations: English Remains Current Source", "description": "IT/FR/ES User Guide translations for AI Export are explicitly deferred. English domain manuals are the current authoritative source. The book link uses the current domain's English manual or the localized shared fallback. Documentation closure explicitly records the deferral as a resolved follow-up, not a forgotten item.", "file_type": "rationale", "source_file": "wiki/decisions/ai-export-versioned-snapshot-boundary.md", "source_location": "## Validation / Success Criteria", "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "concept_deferred_it_fr_es_user_guide_translations"}, {"label": "Dense Portfolio/Broker Export: 60k Token UI Warning Without Automatic Cap or Detail Downgrade", "description": "Dense Portfolio and Broker exports may exceed 60,000 estimated tokens. The existing 20k/60k frontend UI warning remains the user control. Density must not be replaced by an automatic cap, hidden truncation, or automatic detail downgrade. Prompt-size severity is advisory: large complete exports remain copyable after the warning flow. Validated by applied-policy run 20260803T164514.504966Z.", "file_type": "rationale", "source_file": "wiki/decisions/ai-export-versioned-snapshot-boundary.md", "source_location": "## Consequences", "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "concept_dense_export_60k_warning_no_automatic_cap"}], "edges": [{"source": "wiki_decisions_ai-export-versioned-snapshot-boundary", "target": "wiki_concepts_ai-export-catalog-granularity-and-composition", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "wiki/decisions/ai-export-versioned-snapshot-boundary.md", "source_location": "Decision bullet 'Semantic composition remains modular' and Links", "weight": 1.0}, {"source": "wiki_decisions_ai-export-versioned-snapshot-boundary", "target": "wiki_sources_phase00-ai-export-backend-snapshot", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "wiki/decisions/ai-export-versioned-snapshot-boundary.md", "source_location": "Links", "weight": 1.0}, {"source": "wiki_decisions_ai-export-versioned-snapshot-boundary", "target": "wiki_decisions_signal-backend-plugin-architecture", "rel