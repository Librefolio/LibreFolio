{"nodes": [{"id": "risk_spawn_worker_idle_residency_problem", "label": "Risk Spawn Worker Idle Residency Problem", "file_type": "rationale", "source_file": "wiki/problems/risk-spawn-worker-idle-residency.md", "source_location": "Root Cause", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lazy workers stayed resident until FastAPI shutdown because SpawnWorkerPool had no safe transition from idle running state back to lazy state."}, {"id": "risk_spawn_worker_idle_residency_generation_safe_all_lane_idle_reap", "label": "Generation-Safe All-Lane Idle Reap", "file_type": "rationale", "source_file": "wiki/problems/risk-spawn-worker-idle-residency.md", "source_location": "Solution", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When pending work reaches zero, a generation-tagged reaper eventually stops every lane only if its generation remains current."}, {"id": "risk_spawn_worker_idle_residency_pending_zero_lock_recheck", "label": "Locked pending == 0 Recheck", "file_type": "rationale", "source_file": "wiki/problems/risk-spawn-worker-idle-residency.md", "source_location": "Solution", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The reaper acquires the pool lock and rechecks _pending == 0 before stopping lanes, preventing races with newly queued or in-flight work."}, {"id": "risk_spawn_worker_idle_residency_generation_token_invalidation", "label": "Generation Token Invalidation", "file_type": "rationale", "source_file": "wiki/problems/risk-spawn-worker-idle-residency.md", "source_location": "Solution", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accepting new work invalidates the scheduled reap generation so stale timers cannot stop active lanes."}, {"id": "risk_spawn_worker_idle_residency_simulation_idle_timeout_600_seconds", "label": "Simulation Idle Timeout Default: 600 Seconds", "file_type": "rationale", "source_file": "wiki/problems/risk-spawn-worker-idle-residency.md", "source_location": "Solution", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simulation domain has its own configurable idle timeout, default 600 seconds."}, {"id": "risk_spawn_worker_idle_residency_optimization_idle_timeout_600_seconds", "label": "Optimization Idle Timeout Default: 600 Seconds", "file_type": "rationale", "source_file": "wiki/problems/risk-spawn-worker-idle-residency.md", "source_location": "Solution", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optimization domain has its own configurable idle timeout, default 600 seconds."}, {"id": "risk_spawn_worker_idle_residency_all_lanes_stopped", "label": "All Lanes Stopped on Idle Reap", "file_type": "rationale", "source_file": "wiki/problems/risk-spawn-worker-idle-residency.md", "source_location": "Solution", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A valid idle reap stops every lane and clears lane state without permanently closing the pool."}, {"id": "risk_spawn_worker_idle_residency_lazy_restart_new_pids", "label": "Lazy Restart with New PIDs", "file_type": "rationale", "source_file": "wiki/problems/risk-spawn-worker-idle-residency.md", "source_location": "Solution", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The next request starts fresh lanes lazily and tests verify new PIDs after restart."}, {"id": "risk_spawn_worker_idle_residency_timeout_zero_disables_reap", "label": "Idle Timeout 0 Disables Reap", "file_type": "rationale", "source_file": "wiki/problems/risk-spawn-worker-idle-residency.md", "source_location": "Solution", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Configuring idle timeout to zero disables idle reap."}, {"id": "risk_spawn_worker_idle_residency_queued_inflight_s