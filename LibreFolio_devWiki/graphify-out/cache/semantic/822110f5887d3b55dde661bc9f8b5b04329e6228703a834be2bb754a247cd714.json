{"nodes": [{"id": "risk_quant_engine_process_boundary_decision", "label": "Risk Quantitative Engine Process Boundary", "file_type": "rationale", "source_file": "wiki/decisions/risk-quant-engine-process-boundary.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LibreFolio isolates QuantLib simulation and Riskfolio optimization in separate lazy spawn pools with warm reuse, generation-safe all-lane idle reap, 600-second domain defaults, and lazy restart with new PIDs."}, {"id": "risk_quant_engine_process_boundary_in_process_thread_offload", "label": "In-Process Thread Offload Option", "file_type": "rationale", "source_file": "wiki/decisions/risk-quant-engine-process-boundary.md", "source_location": "Options Considered", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected as the quantitative execution boundary because low IPC cost does not remove native computation or memory from the web process."}, {"id": "risk_quant_engine_process_boundary_fresh_process_per_request", "label": "Fresh Child per Request Option", "file_type": "rationale", "source_file": "wiki/decisions/risk-quant-engine-process-boundary.md", "source_location": "Options Considered", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected because strong isolation would repeatedly pay QuantLib and Riskfolio import and solver startup costs."}, {"id": "risk_quant_engine_process_boundary_persistent_spawn_pools", "label": "Idle-Reaped Spawn Worker Pools", "file_type": "rationale", "source_file": "wiki/decisions/risk-quant-engine-process-boundary.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separate lazy spawn pools combine native-process isolation, warm reuse, bounded concurrency, targeted recycling, independent failure domains, and bounded idle memory residency."}, {"id": "risk_quant_engine_process_boundary_process_isolation", "label": "Quantitative Process Isolation", "file_type": "rationale", "source_file": "wiki/decisions/risk-quant-engine-process-boundary.md", "source_location": "Context", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Native CPU, memory, library faults, and runtime failure modes must remain outside the FastAPI process."}, {"id": "risk_quant_engine_process_boundary_quantlib_1_43", "label": "QuantLib 1.43", "file_type": "document", "source_file": "wiki/decisions/risk-quant-engine-process-boundary.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "risk_quant_engine_process_boundary_riskfolio_lib_7_0_1", "label": "Riskfolio-Lib 7.0.1", "file_type": "document", "source_file": "wiki/decisions/risk-quant-engine-process-boundary.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "risk_quant_engine_process_boundary_numpy_test_oracles", "label": "NumPy Independent Test Oracles", "file_type": "rationale", "source_file": "wiki/decisions/risk-quant-engine-process-boundary.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NumPy remains for linear algebra, aggregation, and independent mathematical oracles, not as a silent production simulation fallback."}, {"id": "risk_quant_engine_process_boundary_independent_failure_domains", "label": "Independent Quantitative Failure Domains", "file_type": "rationale", "source_file": "wiki/decisions/risk-quant-engine-process-boundary.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simulation and optimization have separate capacity, timeout, cache, worker, and recovery domains so one engine cannot exhaust or destabilize the other."}, {"id": "risk_quant_engine_process_boundary_targeted_lane_recycle", "label": "Targeted Worker-Lane Recycling", "file_type": "rationale", "source_file": "wiki/decisions/risk-quant-engine-process-boundary.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A timeout, crash, or invalid response closes and recreates only the affected lane."}, {"id": "risk_quant_engine_process_boundary_serializable_dto_boundary", "label": "Serializable DTO Process Boundary", "file_type": "rationale", "source_file": "wiki/decisions/risk-quant-engine-process-boundary.md", "source_location": "Consequences", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only serializable API and service DTOs cross the process boundary; QuantLib, pandas, CVXPY, and Riskfolio objects remain inside workers."}, {"id": "risk_quant_engine_process_boundary_no_silent_fallback", "label": "No Silent Quantitative Fallback", "file_type": "rationale", "source_file": "wiki/decisions/risk-quant-engine-process-boundary.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "QuantLib or Riskfolio failure is surfaced rather than silently substituting a different production engine."}, {"id": "risk_quant_engine_process_boundary_bounded_worker_capacity", "label": "Bounded Quantitative Worker Capacity", "file_type": "rationale", "source_file": "wiki/decisions/risk-quant-engine-process-boundary.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each pool has a bounded queue and configurable worker count to control concurrency and resource use."}, {"id": "risk_quant_engine_process_boundary_fastapi_web_process", "label": "FastAPI Web Process", "file_type": "document", "source_file": "wiki/decisions/risk-quant-engine-process-boundary.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "risk_quant_engine_process_boundary_simulation_pool", "label": "QuantLib Simulation Pool", "file_type": "document", "source_file": "wiki/decisions/risk-quant-engine-process-boundary.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "risk_quant_engine_process_boundary_optimization_pool", "label": "Riskfolio Optimization Pool", "file_type": "document", "source_file": "wiki/decisions/risk-quant-engine-process-boundary.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "risk_quant_engine_process_boundary_worker_memory_budget", "label": "Quantitative Worker Memory Budget", "file_type": "rationale", "source_file": "wiki/decisions/risk-quant-engine-process-boundary.md", "source_location": "Consequences", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measured fixtures require roughly 175 MB per warm simulation worker and 341 MB per warm optimization worker; extra concurrency therefore costs approximately linear RSS."}, {"id": "risk_quant_engine_process_boundary_simulation_idle_timeout_600_seconds", "label": "Simulation Idle Timeout Default: 600 Seconds", "file_type": "rationale", "source_file": "wiki/decisions/risk-quant-engine-process-boundary.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Simulation pool independently defaults to a 600-second idle timeout."}, {"id": "risk_quant_engine_process_boundary_optimization_idle_timeout_600_seconds", "label": "Optimization Idle Timeout Default: 600 Seconds", "file_type": "rationale", "source_file": "wiki/decisions/risk-quant-engine-process-boundary.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optimization pool independently defaults to a 600-second idle timeout."}, {"id": "risk_quant_engine_process_boundary_all_lane_idle_reap", "label": "All-Lane Idle Reap", "file_type": "rationale", "source_file": "wiki/decisions/risk-quant-engine-process-boundary.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After a pool remains idle for its timeout, every lane is stopped to release native-library memory."}, {"id": "risk_quant_engine_process_boundary_lazy_restart_new_pids", "label": "Lazy Restart with New PIDs", "file_type": "rationale", "source_file": "wiki/decisions/risk-quant-engine-process-boundary.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The next request recreates lanes lazily with new process IDs after idle reap."}], "edges": [{"source": "risk_quant_engine_process_boundary_decision", "target": "risk_quant_engine_process_boundary_fresh_process_per_request", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "wiki/decisions/risk-quant-engine-process-boundary.md", "source_location": "Options Considered", "weight": 1.0}, {"source": "risk_quant_engine_process_boundary_decision", "target": "risk_quant_engine_process_boundary_in_process_thread_offload", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "wiki/decisions/risk-quant-engine-process-boundary.md", "source_location": "Options Considered", "weight": 1.0}, {"source": "risk_quant_engine_process_boundary_decision", "target": "risk_quant_engine_process_boundary_persistent_spawn_pools", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "wiki/decisions/risk-quant-engine-process-boundary.md", "source_location": "Decision", "weight": 1.0}, {"source": "risk_quant_engine_process_boundary_no_silent_fallback", "target": "risk_quant_engine_proces