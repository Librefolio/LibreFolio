{"nodes": [{"id": "cancellation_safe_inflight_deduplication_cancellation_safe_inflight_deduplication", "label": "Cancellation-Safe In-Flight Calculation Deduplication", "file_type": "rationale", "source_file": "wiki/concepts/cancellation-safe-inflight-deduplication.md", "source_location": "Definition", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identical concurrent cache misses share one expensive child-process job without allowing a cancelled follower to cancel shared work or a cancelled leader to leave followers waiting forever."}, {"id": "cancellation_safe_inflight_deduplication_content_keyed_cache", "label": "Content-Keyed Quantitative Cache", "file_type": "document", "source_file": "wiki/concepts/cancellation-safe-inflight-deduplication.md", "source_location": "Definition", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cancellation_safe_inflight_deduplication_shared_future", "label": "Shared In-Flight Future", "file_type": "document", "source_file": "wiki/concepts/cancellation-safe-inflight-deduplication.md", "source_location": "Definition", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cancellation_safe_inflight_deduplication_leader_follower_protocol", "label": "Leader-Follower Calculation Protocol", "file_type": "rationale", "source_file": "wiki/concepts/cancellation-safe-inflight-deduplication.md", "source_location": "The LibreFolio pattern", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One leader publishes the result or exact failure, cancels an unresolved future if itself cancelled, and removes the in-flight entry in finally; followers only await the shared future."}, {"id": "cancellation_safe_inflight_deduplication_asyncio_shield", "label": "asyncio.shield Follower Protection", "file_type": "rationale", "source_file": "wiki/concepts/cancellation-safe-inflight-deduplication.md", "source_location": "The LibreFolio pattern", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shielding follower waits prevents one caller's cancellation from propagating into the future needed by other callers."}, {"id": "cancellation_safe_inflight_deduplication_follower_cancellation_propagation", "label": "Follower Cancellation Propagation", "file_type": "rationale", "source_file": "wiki/concepts/cancellation-safe-inflight-deduplication.md", "source_location": "Why It Matters", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Awaiting a bare shared future lets one cancelled HTTP request abort work required by unrelated followers."}, {"id": "cancellation_safe_inflight_deduplication_orphaned_follower_wait", "label": "Orphaned Follower Wait", "file_type": "rationale", "source_file": "wiki/concepts/cancellation-safe-inflight-deduplication.md", "source_location": "Why It Matters", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A cancelled leader that exits without resolving the shared future leaves followers waiting permanently."}, {"id": "cancellation_safe_inflight_deduplication_success_only_immutable_cache", "label": "Success-Only Immutable Result Cache", "file_type": "rationale", "source_file": "wiki/concepts/cancellation-safe-inflight-deduplication.md", "source_location": "The LibreFolio pattern", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only successful immutable results are retained in the content cache."}], "edges": [{"source": "cancellation_safe_inflight_deduplication_cancellation_safe_inflight_deduplication", "target": "cancellation_safe_inflight_deduplication_content_keyed_cache", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "wiki/concepts/cancellation-safe-inflight-deduplication.md", "source_location": "Definition", "weight": 1.0}, {"s