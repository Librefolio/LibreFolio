{"nodes": [{"id": "mkdocs_ai_export_technical_sampling_page", "label": "AI Export Technical Sampling", "file_type": "document", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_sampling.md", "source_location": "L1-L4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "mkdocs_ai_export_rational_calendar_bucket_formula", "label": "Rational Calendar-Bucket Formula", "file_type": "rationale", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_sampling.md", "source_location": "L6-L53", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decimal arithmetic with explicit ROUND_HALF_UP produces deterministic, positive, monotonic, K-bounded, gap-free, overlap-free calendar buckets clipped exactly to the requested inclusive period."}, {"id": "mkdocs_ai_export_recent_daily_calendar_window", "label": "Recent Seven-Day Daily Calendar Window", "file_type": "rationale", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_sampling.md", "source_location": "L55-L67", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The newest seven calendar days remain daily for every detail level and temporal class; this is calendar sampling rather than market-session sampling, and empty intervals never become invented observations or zeroes."}, {"id": "mkdocs_ai_export_calendar_bucket_policy_matrix", "label": "Calendar-Bucket Sampling Policy Matrix", "file_type": "rationale", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_sampling.md", "source_location": "L69-L96", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exact P, M, and K rows combine Compact, Standard, or Full detail with six temporal classes while preserving monotonic density ordering."}, {"id": "mkdocs_ai_export_detail_only_price_rate_sampling", "label": "Detail-Only Price and Rate Sampling", "file_type": "rationale", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_sampling.md", "source_location": "L98-L108", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Asset prices, FX rates, and equivalent reference series use detail level only; Signal temporal classes never alter reference-series density."}, {"id": "mkdocs_ai_export_plugin_owned_temporal_class_resolution", "label": "Plugin-Owned Temporal Class Resolution", "file_type": "rationale", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_sampling.md", "source_location": "L110-L120", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each Signal plugin resolves one temporal class from normalized parameters, after which central policy selects the matrix row without branching on Signal codes."}, {"id": "mkdocs_ai_export_shared_multi_output_indicator_grid", "label": "Shared Multi-Output Indicator Bucket Grid", "file_type": "rationale", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_sampling.md", "source_location": "L154-L168", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every output of a multi-output Signal instance shares one bucket grid, while full-period summaries and latest observed values remain independent of bucket density."}, {"id": "mkdocs_ai_export_public_indicator_history_row_limits", "label": "Public Indicator History Row Limits", "file_type": "rationale", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_sampling.md", "source_location": "L169-L190", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compact retains five and Standard ten uniformly selected non-empty rows per entity and Signal instance, while Full retains all; scope, outputs, latest values, and full-period summaries do not change."}, {"id": "mkdocs_ai_export_warmup_before_bucket_aggregation", "label": "Warm-Up Before Bucket Aggregation", "file_type": "rationale", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_sampling.md", "source_location": "L192-L218", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Signal calculations and annotations run on observation-level warm-up-inclusive input before slicing to the exported period and aggregating numeric history; future rates are never used."}, {"id": "mkdocs_ai_export_observation_level_event_selection", "label": "Observation-Level Event Selection Policy", "file_type": "rationale", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_sampling.md", "source_location": "L220-L258", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Events are detected from original observations, validated and semantically deduplicated, then selected independently per entity and annotation by a detail-owned recent window plus minimum latest count; the policy is not a hard cap or relevance ranking."}, {"id": "mkdocs_ai_export_focused_context_sampling_contracts", "label": "Focused Context Sampling Contracts", "file_type": "rationale", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_sampling.md", "source_location": "L260-L288", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Financial-analysis context components use narrower backend-declared, component-local limits without changing global Compact, Standard, or Full technical scope and density policies."}, {"id": "mkdocs_ai_export_public_empty_temporal_row_omission", "label": "Public Empty Temporal Row Omission Policy", "file_type": "rationale", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_sampling.md", "source_location": "L290-L308", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The renderer omits only temporally empty rows with nominal metadata; meaningful zeroes remain, and backend bucket boundaries, calculations, periods, sampling policy, and coverage are unchanged."}, {"id": "mkdocs_ai_export_latest_per_category_context_event_policy", "label": "Latest-per-Category Context Event Policy", "file_type": "rationale", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_sampling.md", "source_location": "L310-L324", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Focused market contexts retain at most one deterministic latest event per entity and plugin-owned Signal category, separately from the complete technical event-selection policy."}, {"id": "mkdocs_ai_export_fx_observed_range_position", "label": "FX Observed Range Position", "file_type": "rationale", "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_sampling.md", "source_location": "L326-L337", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Conversion-timing evidence locates the current genuine rate within the observed minimum-to-maximum range; it is neither a percentile nor a forecast and explicitly reports flat, empty, or partial history."}], "edges": [{"source": "mkdocs_ai_export_technical_sampling_page", "target": "mkdocs_ai_export_rational_calendar_bucket_formula", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_sampling.md", "source_location": "L6-L53", "weight": 1.0}, {"source": "mkdocs_ai_export_technical_sampling_page", "target": "mkdocs_ai_export_recent_daily_calendar_window", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "mkdocs-en/docs/developer/architecture/patterns/ai_export_sampling.md", "source_location": "L55-L67", "weight": 1.0}, {"source": "mkdocs_ai_export_technical_sampling_page", "target": "